# ============================================================
# Taily Accounting Software - Environment Configuration
# Copy this file to .env and configure your values.
# DO NOT commit .env to version control!
# ============================================================

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Session & Encryption Secret (min 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-32-character-random-secret-key-goes-here

# Local Development Database (SQLite file)
DATABASE_URL="file:./dev.db"

# Production Database (PostgreSQL - Vercel Postgres / Supabase / Neon / RDS)
# When set, scripts/prepare-db.js automatically switches Prisma to postgresql provider
# POSTGRES_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Development Features (Set to 'true' only in local development to allow auto-seeding on login)
ALLOW_DEV_AUTO_SEED=false

